{
    "name": "midnight/intl-locale",
    "description": "ECMAScript Intl.Locale for PHP",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/MidnightDesign/locale-php",
    "support": {
        "issues": "https://github.com/MidnightDesign/locale-php/issues",
        "source": "https://github.com/MidnightDesign/locale-php"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "carthage-software/mago": "1.48.0",
        "friendsofphp/php-cs-fixer": "3.95.25",
        "infection/infection": "0.31.9",
        "phpstan/phpstan": "2.1.32",
        "phpunit/phpunit": "11.5.56",
        "symfony/yaml": "^7.4",
        "vimeo/psalm": "6.17.0"
    },
    "autoload": {
        "psr-4": {
            "Midnight\\Intl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Midnight\\Intl\\Tests\\": "tests/",
            "Midnight\\Intl\\Tools\\": "tools/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "archive": {
        "exclude": [
            "/.ci",
            "/.codex",
            "/.github",
            "/.dockerignore",
            "/.git",
            "/.gitignore",
            "/.php-cs-fixer.cache",
            "/.php-cs-fixer.dist.php",
            "/.phpunit.cache",
            "/AGENTS.md",
            "/WAYFINDER.md",
            "/Dockerfile",
            "/build",
            "/compose.yaml",
            "/composer.lock",
            "/docs/agents",
            "/infection.porcelain.json5",
            "/infection.spec.json5",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/psalm.xml",
            "/tests",
            "/tools",
            "/vendor"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test:package": "php tools/test-package-install.php",
        "test:unit": "phpunit --testsuite unit",
        "test:state": "phpunit tests/Tooling/AmbientStateTest.php",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "analyse:psalm:min": "psalm --php-version=8.2 --memory-limit=512M --no-cache --no-diff --no-progress",
        "analyse:psalm:current": "psalm --php-version=8.5 --memory-limit=512M --no-cache --no-diff --no-progress",
        "analyse:mago:min": "mago --php-version=8.2 --colors=never analyze --minimum-fail-level=warning src",
        "analyse:mago:current": "mago --php-version=8.5 --colors=never analyze --minimum-fail-level=warning src",
        "style": "php-cs-fixer check --diff --verbose",
        "mutation:spec": "infection --configuration=infection.spec.json5 --with-uncovered --min-msi=100 --min-covered-msi=100 --no-progress --no-interaction",
        "mutation:porcelain": "infection --configuration=infection.porcelain.json5 --with-uncovered --min-msi=100 --min-covered-msi=100 --no-progress --no-interaction",
        "ci:matrix": "php tools/ci-matrix.php",
        "ci:verify": "php tools/verify-ci.php",
        "data:generate": "php tools/generate-data.php",
        "data:check": "php tools/generate-data.php --check",
        "data:verify-sources": "php tools/verify-data-sources.php",
        "test262:generate": "php tools/transpile-test262.php",
        "test262:check": "php tools/transpile-test262.php --check"
    }
}
