{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": ["/^Locale\\.php$/", "/^Internal\\/Data\\/LocaleAliases\\.php$/"]
    },
    "testFrameworkOptions": "--testsuite=test262-upstream",
    "timeout": 10,
    "logs": {
        "json": "build/infection/spec/infection.json",
        "text": "build/infection/spec/infection.log"
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true
    }
}
